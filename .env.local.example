# ==============================================================================
# CONFIGURACIÓN DE CONEXIÓN CON SUPABASE (POSTGRESQL)
# ==============================================================================
# 1. Ingresa a tu proyecto en https://supabase.com
# 2. Ve a Project Settings -> API
# 3. Copia la URL del proyecto y la clave Publishable o anon (public)

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publishable-o-anon-aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-aqui
